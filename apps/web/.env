# SHARED ENVIROMENT VARIABLES
# HERE YOU CAN ADD ALL THE **PUBLIC** ENVIRONMENT VARIABLES THAT ARE SHARED ACROSS ALL THE ENVIROMENTS
# PLEASE DO NOT ADD ANY CONFIDENTIAL KEYS OR SENSITIVE INFORMATION HERE
# ONLY CONFIGURATION, PATH, FEATURE FLAGS, ETC.
# TO OVERRIDE THESE VARIABLES IN A SPECIFIC ENVIRONMENT, PLEASE ADD THEM TO THE SPECIFIC ENVIRONMENT FILE (e.g. .env.development, .env.production)

# SITE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=PropOps
NEXT_PUBLIC_SITE_TITLE="PropOps - Commercial Association Billing & Management"
NEXT_PUBLIC_SITE_DESCRIPTION="PropOps helps commercial property associations manage units, billing, payments, and maintenance charges in one platform."
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# AUTH — phone OTP only; password/magic-link disabled for PropOps
NEXT_PUBLIC_AUTH_PASSWORD=false
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_AUTH_OTP=true
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Set to true in development to skip real SMS and show OTP in console / UI hint
NEXT_PUBLIC_MOCK_OTP=true
# Allow unknown phone numbers to self-register on sign-in. PropOps is
# invite-based; set to false in production once invitation provisioning lands.
NEXT_PUBLIC_ALLOW_PHONE_SIGNUP=true

# BILLING — SaaS subscription billing disabled; PropOps uses its own domain billing engine
NEXT_PUBLIC_BILLING_PROVIDER=stripe

# CMS — keystatic (MakerKit default). PropOps doesn't author CMS content, but the
# stock sitemap.ts / marketing routes call createCmsClient() at build time, and an
# EMPTY value makes the CMS factory throw "Implementation '' not found" during
# prerender. keystatic reads the bundled content/ dir and builds cleanly with no
# extra config. (Stripping the marketing/CMS surface entirely is a separate cleanup.)
CMS_CLIENT=keystatic

# LOCALES PATH
NEXT_PUBLIC_LOCALES_PATH=apps/web/public/locales

# FEATURE FLAGS
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=false
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=false
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_BILLING=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_DELETION=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_BILLING=false
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_CREATION=true
NEXT_PUBLIC_ENABLE_TEAM_ACCOUNTS_ONLY=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_REALTIME_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_VERSION_UPDATER=false
NEXT_PUBLIC_LANGUAGE_PRIORITY=application

# NEXTJS
NEXT_TELEMETRY_DISABLED=1