# ============================================================
# .env.local.example — copy this to .env.local and fill in values
#
# NEVER commit .env.local — it is gitignored.
# Get the actual values from the team password manager (Ooruda / Supabase entries).
#
# Three-environment setup:
#   Local dev  → point at Ooruda Development (default below)
#   Staging    → Ooruda Development  (ref: bcdosjrbkkemsqowhigj)
#   Production → Ooruda Production   (ref: vkxchopjqakvftcnxwie)
#
# See DEPLOYMENT.md for the full setup guide.
# ============================================================

# ── SUPABASE — Ooruda Development (ACTIVE for local dev) ─────────────────────
# Get these from: Supabase dashboard → Ooruda Development → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=<dev-anon-key>
SUPABASE_SECRET_KEY=<dev-service-role-key>

# Your personal Supabase CLI access token (not project-specific)
# Get from: supabase.com → Account → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=<your-personal-supabase-access-token>

# ── SUPABASE — Ooruda Production (inactive — uncomment to point at prod) ──────
# NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=<prod-anon-key>
# SUPABASE_SECRET_KEY=<prod-service-role-key>

# ── DATABASE WEBHOOK ──────────────────────────────────────────────────────────
# Must match the secret configured in Supabase → Database → Webhooks → Header
# For local dev any random string works; for staging/prod use the real secret.
SUPABASE_DB_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET

# ── SMS / OTP ─────────────────────────────────────────────────────────────────
# These vars drive the @kit/sms server-action adapter only.
# Real OTP delivery (auth hook) is handled entirely in Supabase function secrets
# — see supabase/functions/custom-sms-hook/index.ts for details.
#
# For local dev: keep SMS_PROVIDER=mock and MOCK_OTP=true (no real SMS sent).
SMS_PROVIDER=mock
MOCK_OTP=true
# To use a real provider locally, set SMS_PROVIDER and the matching key below:
# SMS_PROVIDER=twofactor
# TWOFACTOR_API_KEY=<get from 2factor.in dashboard>
# TWOFACTOR_TEMPLATE_NAME=<optional named template>

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Transactional email for admin notifications (not auth — auth uses phone OTP).
# Resend is the default; nodemailer/SMTP is available as a fallback.
MAILER_PROVIDER=resend
RESEND_API_KEY=<get from resend.com → API Keys>
EMAIL_SENDER=hello@ooruda.com

# Nodemailer/SMTP alternative (comment out Resend block above if using this):
# MAILER_PROVIDER=nodemailer
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_TLS=false
# EMAIL_USER=<smtp-username>
# EMAIL_PASSWORD=<smtp-password>

# ── RAZORPAY ─────────────────────────────────────────────────────────────────
# Fallback keys — per-association keys are stored in the DB.
# Always use rzp_test_ keys for local dev and staging. NEVER use rzp_live_ locally.
# Get test keys from: Razorpay dashboard → Settings → API Keys → Test mode
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>

# ── CONTACT ───────────────────────────────────────────────────────────────────
CONTACT_EMAIL=hello@ooruda.com

# ── EARLY ACCESS PIN GATE ────────────────────────────────────────────────────
# The PIN shown on the early-access landing page.
ACCESS_PIN=<ask-team-for-pin>

# ── TEMPORARY: BILL DISPATCH TOOL ──────────────────────────────────────────
# Set to 'true' in local/staging ONLY. Do NOT set in production.
# Remove this flag once automated email notifications go live.
NEXT_PUBLIC_ENABLE_BILL_DISPATCH=true
