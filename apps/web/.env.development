# Development-only overrides.
# Supabase credentials come from .env.local (higher priority, gitignored).
# Only put non-secret, dev-specific config here.

# Webhook secret for local testing
SUPABASE_DB_WEBHOOK_SECRET=WEBHOOKSECRET

# Email — local Supabase inbucket (used only when running local Supabase)
EMAIL_SENDER="PropOps <noreply@propops.app>"
EMAIL_PORT=54325
EMAIL_HOST=localhost
EMAIL_TLS=false
EMAIL_USER=user
EMAIL_PASSWORD=password
CONTACT_EMAIL=dev@propops.app

# Mailer provider for local dev
MAILER_PROVIDER=nodemailer
